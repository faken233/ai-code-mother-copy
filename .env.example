# 代码生成系统环境变量模板
# 复制为 .env 并填入真实值（.env 已被 gitignore，不进 git）
# 本地 IDE 运行与 Docker Compose 运行均从此文件读取环境变量

# ===== 应用端口 =====
# 本地与 compose 后端均为 8123
SERVER_PORT=8123
BACKEND_PORT=8123
FRONTEND_PORT=8080

# ===== 平台数据源（本地连 localhost，compose 内覆盖为服务名）=====
MYSQL_URL=jdbc:mysql://localhost:3306/yu_ai_code_mother?useUnicode=true&characterEncoding=UTF-8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456

# ===== 平台 Redis（本地连 localhost，compose 内覆盖为服务名）=====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# ===== AI 模型配置 =====
LLM_API_KEY=<Your API Key>
LLM_BASE_URL=https://api.deepseek.com
# 同步模型（AiServices 兜底用）；流式统一用 LLM_STREAMING_MODEL（所有生成类型共用）
LLM_CHAT_MODEL=deepseek-flash
LLM_STREAMING_MODEL=deepseek-flash
LLM_ROUTING_MODEL=deepseek-flash
LLM_ROUTING_BASE_URL=https://api.deepseek.com
# 思考强度（none/low/high/max）：none 关闭思考，其余开启。low 限制过度思考导致 token 耗尽、正文为空；high/max 思考更充分但更慢更贵
LLM_REASONING_EFFORT=low

# ===== COS 对象存储 =====
COS_HOST=your-custom-domain.com
COS_SECRET_ID=your-secret-id
COS_SECRET_KEY=your-secret-key
COS_REGION=ap-shanghai
COS_BUCKET=your-bucket-name

# ===== Pexels / DashScope =====
PEXELS_API_KEY=<Your API Key>
DASHSCOPE_API_KEY=<Your API Key>
DASHSCOPE_IMAGE_MODEL=wan2.2-t2i-flash

# ===== 平台中间件密码（compose 启动 MySQL 用）=====
PLATFORM_MYSQL_PASSWORD=123456

# ===== 沙箱专用中间件（与平台物理隔离）=====
SANDBOX_MYSQL_HOST=host.docker.internal
SANDBOX_MYSQL_PORT=3307
SANDBOX_MYSQL_USER=root
SANDBOX_MYSQL_PASSWORD=123456
SANDBOX_REDIS_HOST=host.docker.internal
SANDBOX_REDIS_PORT=6380

# ===== 沙箱配置 =====
SANDBOX_ENABLED=true
SANDBOX_IMAGE=code-sandbox:latest
# 主服务访问沙箱容器地址：本地直跑=localhost，compose 内=host.docker.internal
SANDBOX_HOST=localhost

# ===== 代码输出 / 部署目录 =====
CODE_OUTPUT_DIR=./tmp/code_output
CODE_DEPLOY_DIR=./tmp/code_deploy

# ===== 容器化部署（P5）=====
DEPLOY_ENABLED=true
# 部署镜像基础镜像（本地需已存在，默认 node:18-alpine）
DEPLOY_BASE_IMAGE=node:18-alpine
# 保留版本数（含当前版本）
DEPLOY_KEEP_VERSIONS=5
# 部署地址：{scheme}://{deployKey}.{suffix}:{port}/
CODE_DEPLOY_SCHEME=http
CODE_DEPLOY_HOST_SUFFIX=app.localhost
CODE_DEPLOY_PORT=8124
