# 代码生成系统一键部署环境变量示例
# 复制为 .env 并填入真实值（.env 已被 gitignore，不进 git）

# ===== 端口 =====
BACKEND_PORT=8123
FRONTEND_PORT=8080

# ===== 平台中间件（平台主服务使用）=====
PLATFORM_MYSQL_PASSWORD=123456
# platform-mysql 默认库 yu_ai_code_mother 已自动创建

# ===== 沙箱专用中间件（沙箱项目使用，与平台物理隔离）=====
SANDBOX_MYSQL_PASSWORD=123456

# ===== 沙箱镜像 =====
# 需要提前构建：cd sandbox && docker build -t code-sandbox:latest .
SANDBOX_IMAGE=code-sandbox:latest

# ===== 代码输出 / 部署目录（宿主机，与沙箱容器共享）=====
CODE_OUTPUT_DIR=./tmp/code_output
CODE_DEPLOY_DIR=./tmp/code_deploy

# ===== AI 模型配置 =====
LLM_API_KEY=<Your API Key>
LLM_BASE_URL=https://api.deepseek.com

# ===== Spring profile =====
SPRING_PROFILES_ACTIVE=local
