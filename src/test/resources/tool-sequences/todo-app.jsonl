// 模拟 AI 生成 todo 应用的工作序列（JSON Lines）
// 每行一个工具调用，等价于 AI 流式输出并执行的一组 tool call。
// 注意：content 内换行用 \n 转义；@ToolMemoryId 参数（appId）由执行器自动注入。

{"tool":"writeFile","arguments":{"relativeFilePath":"backend/pom.xml","content":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<project xmlns=\"http://maven.apache.org/POM/4.0.0\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xsi:schemaLocation=\"http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd\">\n  <modelVersion>4.0.0</modelVersion>\n  <parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>3.5.4</version><relativePath/></parent>\n  <groupId>com.example</groupId><artifactId>todo</artifactId><version>1.0</version>\n  <properties><java.version>21</java.version></properties>\n  <dependencies>\n    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>\n    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>\n  </dependencies>\n  <build><plugins><plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin></plugins></build>\n</project>\n"}}
{"tool":"writeFile","arguments":{"relativeFilePath":"backend/src/main/resources/application.yml","content":"spring:\n  application:\n    name: todo\nserver:\n  port: 8081\n"}}
{"tool":"writeFile","arguments":{"relativeFilePath":"backend/src/main/java/com/example/TodoApplication.java","content":"package com.example;\nimport org.springframework.boot.SpringApplication;\nimport org.springframework.boot.autoconfigure.SpringBootApplication;\n@SpringBootApplication\npublic class TodoApplication { public static void main(String[] args) { SpringApplication.run(TodoApplication.class, args); } }\n"}}
{"tool":"writeFile","arguments":{"relativeFilePath":"backend/src/main/java/com/example/TodoController.java","content":"package com.example;\nimport org.springframework.web.bind.annotation.*;\nimport java.util.*;\n@RestController\n@RequestMapping(\"/api/todos\")\npublic class TodoController {\n  private final List<Map<String,Object>> todos = new ArrayList<>();\n  @GetMapping public List<Map<String,Object>> list() { return todos; }\n  @PostMapping public Map<String,Object> add(@RequestBody Map<String,Object> todo) { todo.put(\"id\", todos.size()+1L); todos.add(todo); return todo; }\n}\n"}}
{"tool":"writeFile","arguments":{"relativeFilePath":"frontend/index.html","content":"<!DOCTYPE html>\n<html><head><meta charset=\"utf-8\"><title>Todo</title></head><body><h1>Todo App</h1><input id=\"in\"><button onclick=\"add()\">add</button><ul id=\"list\"></ul><script>async function add(){const t=document.getElementById('in').value;const r=await fetch('/api/todos',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({title:t})});const d=await r.json();const li=document.createElement('li');li.textContent=d.title;document.getElementById('list').appendChild(li);}</script></body></html>\n"}}
{"tool":"buildProject","arguments":{"scope":"backend","skipInstall":true}}
